{
  "manifest_version": 3,
  "name": "QuanVault",
  "version": "1.3.2",
  "description": "QuanVault is the testnet wallet and onboarding layer for the QuanChain ecosystem. It helps users create a wallet, get test QCH, and start using dApps with a simple, secure flow.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://5-189-184-7.sslip.io/*",
    "http://5.189.184.7:8545/*",
    "http://5.189.184.7:8546/*",
    "http://5.189.184.7:8547/*",
    "http://5.189.184.7:8548/*"
  ]
}
